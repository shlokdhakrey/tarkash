# ============================================
# DATABASE
# ============================================
DATABASE_URL="postgresql://postgres@localhost:5432/innovatex?schema=public"
DB_HOST="localhost"
DB_PORT="5432"
DB_USER="postgres"
DB_PASSWORD=""
DB_NAME="innovatex"

# ============================================
# API SERVER
# ============================================
NODE_ENV="development"
API_PORT="4000"
API_URL="http://localhost:4000"
CORS_ORIGIN="http://localhost:3000"

# ============================================
# JWT & AUTHENTICATION
# ============================================
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-in-production"
JWT_REFRESH_EXPIRES_IN="7d"

# ============================================
# FRONTEND
# ============================================
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="InnovateX 2025"
NEXT_PUBLIC_EVENT_DATE="2025-03-15T09:00:00+05:30"
NEXT_PUBLIC_EVENT_NAME="InnovateX 2025"
NEXT_PUBLIC_COLLEGE_NAME="College of Engineering"

# ============================================
# FILE STORAGE (S3 / MinIO)
# ============================================
S3_ENDPOINT="http://localhost:9000"
S3_BUCKET="innovatex-uploads"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_REGION="us-east-1"
S3_USE_SSL="false"
MAX_FILE_SIZE="10485760"

# ============================================
# REDIS (Optional - for caching & rate limiting)
# ============================================
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_PASSWORD=""
REDIS_URL="redis://localhost:6379"

# ============================================
# EMAIL (SendGrid / AWS SES)
# ============================================
EMAIL_PROVIDER="sendgrid"
SENDGRID_API_KEY="SG.your-sendgrid-api-key"
SENDGRID_FROM_EMAIL="noreply@innovatex2025.edu"
SENDGRID_FROM_NAME="InnovateX 2025"

# AWS SES (Alternative)
AWS_SES_REGION="us-east-1"
AWS_SES_ACCESS_KEY=""
AWS_SES_SECRET_KEY=""
AWS_SES_FROM_EMAIL="noreply@innovatex2025.edu"

# ============================================
# MONITORING & OBSERVABILITY
# ============================================
SENTRY_DSN=""
SENTRY_ENVIRONMENT="development"
LOG_LEVEL="debug"

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_TTL="60"
RATE_LIMIT_MAX="100"

# ============================================
# FEATURE TOGGLES
# ============================================
REGISTRATION_OPEN="true"
SUBMISSION_OPEN="true"
MAX_TEAM_SIZE="4"
MIN_TEAM_SIZE="1"

# ============================================
# PAYMENT (Optional - Stripe/Razorpay)
# ============================================
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PUBLISHABLE_KEY=""

RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# ============================================
# ANALYTICS (Optional)
# ============================================
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
NEXT_PUBLIC_MIXPANEL_TOKEN=""

# ============================================
# TIMEZONE
# ============================================
TZ="Asia/Kolkata"
